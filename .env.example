# UNIÓN Local Development Environment Template
# Copy this file to .env and set an explicit local password & DATABASE_URL & PORT.
# DO NOT commit .env or real operational secrets to version control.

# Infrastructure configuration (Docker Compose)
POSTGRES_DB=union
POSTGRES_USER=union_app
POSTGRES_PASSWORD=<replace_with_explicit_local_password>
POSTGRES_PORT=5432

# Application configuration boundary
UNION_ENV=local
DATABASE_URL=postgresql://union_app:<replace_with_explicit_local_password>@localhost:5432/union
PORT=3000
