{
  "name": "@union/core",
  "version": "0.1.0",
  "private": true,
  "description": "UNIÓN Core — Governance, State, Session & Orchestration Engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@union/shared": "*",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11"
  },
  "scripts": {
    "start": "node dist/index.js",
    "db:migrate": "node dist/db/migrations/cli.js",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "node --test dist/**/*.test.js",
    "clean": "tsc -b --clean"
  }
}
